# ── Claude agent (claude_agent_with_spotter3_mcp_server.py) ─────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides. Commented out = the code's default is used.
# ANTHROPIC_MODEL=claude-opus-5
# MCP toolset version. Defaults to `latest`, which always gets the newest
# toolset - convenient, but a ThoughtSpot release can then change the tools and
# the update shape underneath you. Pin a release date for anything you depend
# on; 2026-05-01 was the first release of the Spotter 3 toolset.
# TS_MCP_API_VERSION=2026-05-01
# Full endpoint override. Use /token/mcp (static token + x-ts-host); /bearer/mcp
# is the legacy path and is frozen on the older, pre-Spotter 3 toolset.
# Append &enable-raw-session-updates=true to get the Agent's own updates instead
# of the server's digested ones - the agent reads either shape.
# TS_MCP_URL=https://agent.thoughtspot.app/token/mcp?api-version=latest
# Chat history DB (claude_agent_with_spotter3_mcp_server_and_chat_history.py only).
# CHAT_HISTORY_DB=./server/chat_history.db

# ── ThoughtSpot credentials (agent + React client) ──────────────────────────
# VITE_ prefix exposes these to the browser via Vite's import.meta.env. The server
# also accepts them unprefixed as TS_HOST / TS_AUTH_TOKEN - use those instead if
# only the Python side needs them.
VITE_TS_HOST=your-instance.thoughtspot.cloud
VITE_TS_AUTH_TOKEN=your_thoughtspot_bearer_token

# WARNING: Using a static bearer token (VITE_TS_AUTH_TOKEN) is for development
# and demo purposes only. Do NOT use this approach in production. For production
# deployments, implement the full Trusted Authentication flow where your backend
# securely generates short-lived tokens on behalf of each user.
# See: https://developers.thoughtspot.com/docs/trusted-auth

# ── Embed token minting (server-side, never exposed to the browser) ─────────
# The Visual Embed SDK needs a FRESH token from every getAuthToken call. With these
# set, GET /api/ts-token mints one per request via /api/rest/2.0/auth/token/full.
# Leave them unset and that endpoint falls back to the static VITE_TS_AUTH_TOKEN,
# which trips the SDK's "Duplicate token" alert once the token stops verifying.
#
# Needs the username plus ONE of secret key / password. secret_key wins if both set.
# Generate a secret key: Develop > Customizations > Security Settings >
# Trusted authentication. Note MFA-enabled instances reject username+password.
# TS_EMBED_USERNAME=the_thoughtspot_username_to_embed_as
# TS_SECRET_KEY=your_trusted_auth_secret_key
# TS_EMBED_PASSWORD=that_users_password
# Token lifetime in seconds (default 1800). The cluster default is 300.
# TS_TOKEN_VALIDITY_SEC=1800
