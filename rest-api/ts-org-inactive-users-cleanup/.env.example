# Copy this file to .env and fill in your values:
#   cp .env.example .env

TS_CLUSTER_URL=https://your-cluster.thoughtspot.cloud

# Auth — pick ONE of these two methods
# The account needs "Can administer Org" rights on TS_ORG_ID below.

# Method 1: Trusted Auth secret_key. Can itself be org-scoped on some
# deployments. If you hit "service secret code is not valid", get the key
# from TS_ORG_ID's own Security Settings, or use Method 2 instead.
TS_SECRET_KEY=
TS_ADMIN_USERNAME=

# Method 2: username + password (leave TS_SECRET_KEY blank to use this)
TS_USERNAME=
TS_PASSWORD=

#The org to process
TS_ORG_ID=
